{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regybox-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Setup defaults make the deploy button prompt for these values. After setup,
  // keep the dashboard as the source of truth for every user-owned variable.
  "keep_vars": true,
  "vars": {
    "BOOKING_PLATFORM": "regybox",
    // Trend CrossFit (box 180). Calendar event titles (case-insensitive) on the
    // left, class names exactly as Regybox's app3 shows them on the right.
    "CLASS_MAP": "WOD = WOD; CrossFit = WOD; Open Box = OPEN BOX; OB = OPEN BOX; MAT = MAT; Pilates = MAT; Athletic MAT = ATHLETIC MAT; Senior MAT = SENIOR MAT; Weightlifting = WEIGHTLIFTING; WL = WEIGHTLIFTING; EMOM = EMOM CLUB; EMOM Club = EMOM CLUB; Partner WOD = PARTNER WOD; Trend CT = TREND CT; GYM = GYM",
    "TIMEZONE": "Europe/Lisbon",
    "LOOKAHEAD_HOURS": "73"
  },
  "kv_namespaces": [
    {
      "binding": "REGYBOX_STATE"
    }
  ],
  // Every 15 minutes, two minutes before each quarter hour, so classes that
  // start at :15 or :45 (booking opens 48h earlier) are caught on time too.
  "triggers": {
    "crons": ["13,28,43,58 * * * *"]
  },
  // Lets the bot notice when a secret changes (each change is a new version)
  // and retry a sign-in it paused after Regybox rejected the password.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [{ "name": "BOOKR_COORDINATOR", "class_name": "BookrCoordinator" }]
  },
  "migrations": [{ "tag": "v1-bookr-coordinator", "new_sqlite_classes": ["BookrCoordinator"] }],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
